# Model served by llama-server: a .gguf file in models/, a display name, and the
# context window in tokens. Run `make restart` after changing these.
MODEL_FILE=Llama-3.2-1B-Instruct-Q4_K_M.gguf
MODEL_NAME=Llama 3.2 1B Instruct
CONTEXT_SIZE=4096
# To go back to the 7B coder model:
# MODEL_FILE=qwen2.5-coder-7b-instruct-q4_k_m.gguf
# MODEL_NAME=Qwen2.5-Coder 7B Instruct
# CONTEXT_SIZE=2048

# Copy to .env and set a real key before exposing the API beyond localhost.
# The api service requires this value in the X-API-Key header when non-empty.
API_KEY=

# Optional: override the default system prompt used by POST /chat.
SYSTEM_PROMPT=
